---
import '@fontsource-variable/inter/wght.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content';

interface Props {
  title?: string;
  description?: string;
  /** Path beginning with "/", e.g. "/work/my-film/". */
  path: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Header link base: "" on the homepage, "/" elsewhere. */
  linkBase?: string;
  /** Page contains the pinned three-stage opening. */
  hasOpening?: boolean;
}

const {
  title = site.title,
  description = site.description,
  path,
  ogImage = site.ogImage,
  ogImageAlt = site.ogImageAlt,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  linkBase = '/',
  hasOpening = false,
} = Astro.props;

const canonical = new URL(path, site.url).toString();
const ogImageUrl = new URL(ogImage, site.url).toString();
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0A0A0B" />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:site_name" content={site.brand} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}

    <!-- Enable JS motion only when the user allows it; never leave content hidden if scripts fail. -->
    <script is:inline data-pin-opening={hasOpening ? '1' : undefined}>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (window.matchMedia && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          // Pinned three-stage opening; falls back to the static sequence if its script never starts.
          if (document.currentScript && document.currentScript.dataset.pinOpening) d.classList.add('opening-pinned');
          setTimeout(function () {
            if (!window.__wfMotionReady) d.classList.remove('motion');
            if (!window.__wfOpeningReady) d.classList.remove('opening-pinned');
          }, 3000);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header linkBase={linkBase} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
