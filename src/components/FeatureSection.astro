---
import BackgroundMedia from './BackgroundMedia.astro';
import Media from './Media.astro';
import { backgrounds, linkProjectsFor, projectsFor, type FeatureCopy } from '../content';

interface Props {
  feature: FeatureCopy;
  /** Text-safe area. Alternate between sections so text never sits on the same focal area. */
  layout: 'bottom-left' | 'center-right' | 'top-left';
}

const { feature, layout } = Astro.props;
const media = backgrounds.sections[feature.id];
const related = projectsFor(feature.id).slice(0, 3);
const links = linkProjectsFor(feature.id);
---

<section class:list={['feature', `feature--${layout}`, !media && 'feature--no-media']} id={feature.id} aria-labelledby={`${feature.id}-title`}>
  <BackgroundMedia media={media} variant={feature.id} parallax />
  <div class="feature__scrim" aria-hidden="true"></div>

  <div class="feature__inner wrap">
    <div class="feature__copy" data-reveal>
      <p class="label label--accent">{feature.label}</p>
      <h2 id={`${feature.id}-title`} class="feature__title display">{feature.headline}</h2>
      <p class="feature__text">{feature.copy}</p>

      {
        related.length > 0 && (
          <div class="feature__work">
            <ul class="feature__list">
              {related.map((p) => (
                <li>
                  <a class="feature__item" href={`/work/${p.slug}/`}>
                    <span class="feature__thumb" aria-hidden="true">
                      <Media src={p.cover.src} alt="" focal={p.cover.focal} sizes="96px" widths={[192]} />
                    </span>
                    <span class="feature__item-title">{p.title}</span>
                    <span class="feature__arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="feature__all label link-line" href="#work" data-filter-link={feature.id}>
              All {feature.label} work →
            </a>
          </div>
        )
      }

      {
        links.length > 0 && (
          <ul class="feature__links" aria-label={`${feature.label} projects`}>
            {links.map((l) => (
              <li class="feature__link-row">
                <div class="feature__link-meta">
                  <h3 class="feature__link-title">{l.title}</h3>
                  <p class="feature__link-type label">{l.type}</p>
                </div>
                <a class="feature__link label" href={l.url} target="_blank" rel="noopener noreferrer">
                  {l.label} <span aria-hidden="true">↗</span>
                  <span class="sr-only">: {l.title} (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      media?.type === 'video' && (
        <button class="bg-toggle" type="button" data-bg-toggle hidden>
          <span data-bg-toggle-label>Pause</span>
          <span class="sr-only"> background video</span>
        </button>
      )
    }
  </div>
</section>

<style>
  .feature {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: min(92svh, 900px);
    overflow: hidden;
  }

  /* Until real media is configured, keep the section proportionate to its text. */
  .feature--no-media {
    min-height: min(68svh, 640px);
  }

  .feature > :global(.bg) {
    z-index: -2;
  }

  /* Directional scrim keeps the text-safe side readable over any media. */
  .feature__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .feature--bottom-left .feature__scrim {
    background: linear-gradient(20deg, rgb(10 10 11 / 0.85) 0%, rgb(10 10 11 / 0.35) 45%, transparent 70%);
  }
  .feature--center-right .feature__scrim {
    background: linear-gradient(270deg, rgb(10 10 11 / 0.85) 0%, rgb(10 10 11 / 0.4) 45%, transparent 75%);
  }
  .feature--top-left .feature__scrim {
    background: linear-gradient(160deg, rgb(10 10 11 / 0.85) 0%, rgb(10 10 11 / 0.35) 45%, transparent 70%);
  }
  /* Busy media (e.g. a website recording) behind the copy: also darken the whole text column. */
  .feature--top-left:not(.feature--no-media) .feature__scrim {
    background:
      linear-gradient(90deg, rgb(10 10 11 / 0.72) 0%, rgb(10 10 11 / 0.6) 40%, rgb(10 10 11 / 0.15) 62%, transparent 75%),
      linear-gradient(160deg, rgb(10 10 11 / 0.6) 0%, transparent 45%);
  }

  .feature__inner {
    position: relative;
    display: flex;
    padding-block: clamp(72px, 9vw, 128px);
  }

  .feature--bottom-left .feature__inner {
    align-items: flex-end;
    justify-content: flex-start;
  }
  .feature--center-right .feature__inner {
    align-items: center;
    justify-content: flex-end;
  }
  .feature--top-left .feature__inner {
    align-items: flex-start;
    justify-content: flex-start;
    padding-top: calc(var(--header-h) + clamp(48px, 6vw, 96px));
  }

  .feature__copy {
    display: grid;
    gap: 18px;
    max-width: 44rem;
  }

  .feature--center-right .feature__copy {
    max-width: 36rem;
  }

  .feature__title {
    font-size: clamp(2.9rem, 1.4rem + 5.4vw, 7.25rem);
    line-height: 0.98;
    text-transform: none;
    letter-spacing: -0.005em;
  }

  .feature__text {
    max-width: 40ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: rgb(242 240 234 / 0.88);
  }

  .feature__work {
    display: grid;
    gap: 12px;
    margin-top: 12px;
  }

  .feature__list {
    display: grid;
    border-top: 1px solid var(--c-line-strong);
  }

  .feature__item {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 16px;
    min-height: 60px;
    padding: 8px 0;
    border-bottom: 1px solid var(--c-line-strong);
    text-decoration: none;
  }

  .feature__thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--c-charcoal);
  }

  .feature__item-title {
    font-family: var(--f-display);
    font-size: 1.25rem;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .feature__arrow {
    transition: transform var(--t-med) var(--ease-out);
  }

  .feature__item:hover .feature__arrow,
  .feature__item:focus-visible .feature__arrow {
    transform: translateX(4px);
    color: var(--c-blue);
  }

  /* Link-only projects: name, type and an external link (no media, no detail page). */
  .feature__links {
    display: grid;
    margin-top: 12px;
    border-top: 1px solid var(--c-line-strong);
  }

  .feature__link-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--c-line-strong);
  }

  .feature__link-meta {
    display: grid;
    gap: 4px;
  }

  .feature__link-title {
    font-family: var(--f-display);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
  }

  .feature__link-type {
    color: rgb(242 240 234 / 0.75);
  }

  .feature__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    flex-shrink: 0;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    color: var(--c-ivory);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--t-fast),
      border-color var(--t-fast),
      color var(--t-fast);
  }

  .feature__link:hover {
    background: var(--c-ivory);
    border-color: var(--c-ivory);
    color: var(--c-black);
  }

  .feature__link:focus-visible {
    outline: 2px solid var(--c-blue);
    outline-offset: 3px;
    border-color: var(--c-ivory);
  }

  .feature__all {
    justify-self: start;
    padding-block: 10px;
    color: var(--c-ivory);
  }



  @media (max-width: 720px) {
    .feature {
      min-height: min(88svh, 760px);
    }
    .feature--no-media {
      min-height: min(64svh, 560px);
    }
    .feature--center-right .feature__inner {
      align-items: flex-end;
      justify-content: flex-start;
    }
    .feature--center-right .feature__scrim,
    .feature--bottom-left .feature__scrim {
      background: linear-gradient(0deg, rgb(10 10 11 / 0.9) 0%, rgb(10 10 11 / 0.45) 50%, transparent 80%);
    }
    .feature--top-left .feature__scrim {
      background: linear-gradient(180deg, rgb(10 10 11 / 0.9) 0%, rgb(10 10 11 / 0.45) 50%, transparent 80%);
    }
  }
</style>
