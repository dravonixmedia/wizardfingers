---
import { signature, site } from '../content';
const host = new URL(site.url).host;
---

<section class="sig" aria-labelledby="sig-title" data-sig>
  <div class="wrap">
    <p class="label label--accent sig__label">{signature.label}</p>
    <h2 id="sig-title" class="sr-only">{signature.filmLine} {signature.codeLine}</h2>

    <!-- Animated version (scroll-linked, never pinned) -->
    <div class="sig__stage" aria-hidden="true">
      <div class="sig__box" data-sig-box>
        <div class="sig__chrome">
          <span class="sig__dots"><i></i><i></i><i></i></span>
          <span class="sig__url">{host}</span>
        </div>
        <div class="sig__screen">
          <div class="sig__film">
            <span class="sig__bar sig__bar--top"></span>
            <span class="sig__bar sig__bar--bottom"></span>
            <span class="sig__tc label">00:00:<span data-sig-tc>00:00</span></span>
            <span class="sig__ratio label">2.39 : 1</span>
            <span class="sig__cross"></span>
            <p class="sig__line serif">{signature.filmLine}</p>
          </div>
          <div class="sig__web">
            <span class="sig__nav"><i></i><i></i><i></i></span>
            <span class="sig__block sig__block--h"></span>
            <span class="sig__block sig__block--p"></span>
            <span class="sig__block sig__block--p2"></span>
            <span class="sig__block sig__block--btn"></span>
            <span class="sig__block sig__block--img"></span>
            <p class="sig__code"><span>&lt;</span>story <em>frame</em>=<b>"01"</b> <span>/&gt;</span></p>
            <p class="sig__line sig__line--web display">{signature.codeLine}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Static version for reduced motion / no JS -->
    <div class="sig__static">
      <figure class="sig__still sig__still--film">
        <div class="sig__still-box"><p class="serif">{signature.filmLine}</p></div>
        <figcaption class="label">Frame</figcaption>
      </figure>
      <span class="sig__arrow" aria-hidden="true">→</span>
      <figure class="sig__still sig__still--web">
        <div class="sig__still-box"><p class="display">{signature.codeLine}</p></div>
        <figcaption class="label">Interface</figcaption>
      </figure>
    </div>

    <p class="sig__caption">{signature.caption}</p>
  </div>
</section>

<style>
  .sig {
    --p: 0;
    position: relative;
    padding-block: clamp(80px, 10vw, 160px);
    border-top: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
    background: radial-gradient(60% 50% at 50% 50%, rgb(66 117 255 / 0.08), transparent 70%), var(--c-black);
    overflow: hidden;
  }

  .sig__label {
    margin-bottom: 40px;
  }

  .sig__caption {
    max-width: 44ch;
    margin: 40px auto 0;
    text-align: center;
    color: var(--c-gray);
  }

  /* Only one version is visible at a time */
  :global(html.motion) .sig__stage,
  :global(html.motion-ready) .sig__stage {
    display: block;
  }
  :global(html.motion) .sig__static,
  :global(html.motion-ready) .sig__static {
    display: none;
  }

  .sig__stage {
    display: none;
    perspective: 1400px;
  }

  .sig__box {
    --ratio: calc(2.39 - var(--p) * 0.79);
    position: relative;
    width: min(100%, calc(1100px - var(--p) * 120px));
    margin-inline: auto;
    aspect-ratio: var(--ratio);
    border: 1px solid rgb(242 240 234 / calc(0.12 + var(--p) * 0.2));
    border-radius: calc(var(--p) * 12px);
    background: #0d0d0f;
    overflow: hidden;
    box-shadow: 0 40px 120px -40px rgb(66 117 255 / calc(var(--p) * 0.6));
    display: flex;
    flex-direction: column;
  }

  .sig__chrome {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 16px;
    height: calc(var(--p) * 38px);
    padding-inline: 14px;
    background: var(--c-charcoal);
    border-bottom: 1px solid var(--c-line);
    opacity: var(--p);
    overflow: hidden;
  }

  .sig__dots {
    display: flex;
    gap: 6px;
  }

  .sig__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(242 240 234 / 0.25);
  }

  .sig__dots i:first-child {
    background: var(--c-blue);
  }

  .sig__url {
    flex: 0 1 320px;
    margin-inline: auto;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgb(242 240 234 / 0.06);
    font-family: var(--f-mono);
    font-size: 0.7rem;
    color: var(--c-gray);
    text-align: center;
  }

  .sig__screen {
    position: relative;
    flex: 1;
  }

  .sig__film,
  .sig__web {
    position: absolute;
    inset: 0;
  }

  .sig__film {
    opacity: clamp(0, calc(1 - var(--p) * 2.4), 1);
    background:
      radial-gradient(50% 70% at 65% 50%, rgb(242 240 234 / 0.07), transparent 70%),
      linear-gradient(90deg, transparent 48%, rgb(66 117 255 / 0.5) 50%, transparent 52%) 0 58% / 100% 1px no-repeat;
  }

  .sig__bar {
    position: absolute;
    left: 0;
    right: 0;
    height: calc((1 - var(--p)) * 9%);
    background: #000;
  }
  .sig__bar--top { top: 0; }
  .sig__bar--bottom { bottom: 0; }

  .sig__tc {
    position: absolute;
    top: 14%;
    right: 4%;
    color: var(--c-ivory);
  }

  .sig__ratio {
    position: absolute;
    top: 14%;
    left: 4%;
  }

  .sig__cross {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 22px;
    translate: -50% -50%;
    background:
      linear-gradient(var(--c-line-strong), var(--c-line-strong)) center / 1px 100% no-repeat,
      linear-gradient(var(--c-line-strong), var(--c-line-strong)) center / 100% 1px no-repeat;
  }

  .sig__line {
    position: absolute;
    left: 6%;
    bottom: 18%;
    font-size: clamp(1.4rem, 0.8rem + 2.6vw, 3.4rem);
    line-height: 1;
    max-width: 80%;
  }

  .sig__web {
    opacity: clamp(0, calc(var(--p) * 2.5 - 1.3), 1);
    padding: 5% 6%;
  }

  .sig__nav {
    position: absolute;
    top: 7%;
    right: 6%;
    display: flex;
    gap: 10px;
  }

  .sig__nav i {
    width: 34px;
    height: 6px;
    border-radius: 3px;
    background: rgb(242 240 234 / 0.2);
  }

  .sig__block {
    position: absolute;
    border-radius: 3px;
    background: rgb(242 240 234 / 0.1);
  }
  .sig__block--h { left: 6%; top: 24%; width: 40%; height: 9%; background: rgb(242 240 234 / 0.75); }
  .sig__block--p { left: 6%; top: 38%; width: 32%; height: 3%; }
  .sig__block--p2 { left: 6%; top: 44%; width: 24%; height: 3%; }
  .sig__block--btn { left: 6%; top: 54%; width: 12%; height: 7%; border-radius: 999px; background: var(--c-blue); }
  .sig__block--img {
    right: 6%;
    top: 22%;
    width: 36%;
    height: 50%;
    background:
      radial-gradient(60% 70% at 60% 40%, rgb(66 117 255 / 0.35), transparent 70%),
      rgb(242 240 234 / 0.06);
  }

  .sig__code {
    position: absolute;
    left: 6%;
    top: 12%;
    font-family: var(--f-mono);
    font-size: 0.78rem;
    color: var(--c-gray);
  }
  .sig__code em { color: var(--c-blue); font-style: normal; }
  .sig__code b { color: var(--c-ivory); font-weight: 400; }

  .sig__line--web {
    font-size: clamp(1.4rem, 0.6rem + 2.6vw, 3.2rem);
    bottom: 10%;
    line-height: 0.95;
  }

  /* Static version -------------------------------------------------------- */

  .sig__static {
    display: grid;
    grid-template-columns: 1.2fr auto 1fr;
    align-items: center;
    gap: var(--gutter);
  }

  .sig__still {
    display: grid;
    gap: 12px;
  }

  .sig__still-box {
    display: flex;
    align-items: flex-end;
    padding: 6%;
    border: 1px solid var(--c-line-strong);
    background: #0d0d0f;
    font-size: clamp(1.2rem, 0.8rem + 1.5vw, 2.4rem);
    line-height: 1;
  }

  .sig__still--film .sig__still-box {
    aspect-ratio: 2.39;
    border-block-width: 12px;
    border-block-color: #000;
  }

  .sig__still--web .sig__still-box {
    aspect-ratio: 1.6;
    border-top: 26px solid var(--c-charcoal);
    border-radius: 10px;
  }

  .sig__arrow {
    font-size: 2rem;
    color: var(--c-blue);
  }

  @media (max-width: 720px) {
    .sig__static {
      grid-template-columns: 1fr;
    }
    .sig__arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
    .sig__code,
    .sig__nav,
    .sig__ratio {
      display: none;
    }
    .sig__line {
      font-size: 1.2rem;
    }
    .sig__box {
      --ratio: calc(1.6 - var(--p) * 0.6);
    }
  }
</style>
