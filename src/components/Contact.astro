---
import BackgroundMedia from './BackgroundMedia.astro';
import { backgrounds, contact, contactDestinations } from '../content';

const media = backgrounds.sections.contact;
const hasLinks = contactDestinations.length > 0;
---

<section class:list={['contact', !hasLinks && !media && 'contact--compact']} id="contact" aria-labelledby="contact-title">
  <BackgroundMedia media={media} variant="contact" parallax />
  <div class="wrap contact__inner">
    <div class="contact__head" data-reveal>
      <p class="label label--accent">{contact.label}</p>
      <h2 id="contact-title" class="contact__title display">{contact.headline}</h2>
    </div>

    {
      hasLinks ? (
        <div class="contact__body" data-reveal>
          <p class="contact__intro">{contact.intro}</p>
          <ul class="contact__links" data-reveal-each>
            {contactDestinations.map((d) => (
              <li>
                <a href={d.href} {...(d.external ? { target: '_blank', rel: d.id === 'whatsapp' ? 'noopener noreferrer' : 'noopener noreferrer me' } : {})}>
                  <span class="label">{d.label}</span>
                  <span class="contact__value">{d.display}</span>
                  <span class="contact__arrow" aria-hidden="true">
                    {d.external ? '↗' : '→'}
                  </span>
                  {d.external && <span class="sr-only">(opens in a new tab)</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <p class="contact__unavailable label" data-reveal>
          {contact.unavailable}
        </p>
      )
    }
    {
      media?.type === 'video' && (
        <button class="bg-toggle" type="button" data-bg-toggle hidden>
          <span data-bg-toggle-label>Pause</span>
          <span class="sr-only"> background video</span>
        </button>
      )
    }
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .contact > :global(.bg) {
    z-index: -1;
  }

  .contact__inner {
    position: relative;
    display: grid;
    gap: clamp(32px, 4vw, 56px);
    padding-block: clamp(80px, 10vw, 144px);
  }

  .contact--compact .contact__inner {
    padding-block: clamp(64px, 8vw, 112px);
  }

  .contact__head {
    display: grid;
    gap: 18px;
    max-width: 36rem;
  }

  .contact__title {
    font-size: var(--h-sub);
    line-height: 1.06;
  }

  .contact__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px var(--gutter);
  }

  .contact__intro {
    grid-column: 1 / span 4;
    color: rgb(242 240 234 / 0.82);
    font-size: var(--body-l);
    line-height: 1.5;
  }

  .contact__links {
    grid-column: 6 / -1;
    border-top: 1px solid var(--c-line-strong);
  }

  .contact__links a {
    display: grid;
    grid-template-columns: minmax(8rem, 13rem) 1fr auto;
    align-items: center;
    gap: 16px;
    min-height: 68px;
    padding: 14px 0;
    border-bottom: 1px solid var(--c-line-strong);
    text-decoration: none;
    transition: padding var(--t-med) var(--ease-out);
  }

  .contact__value {
    font-size: var(--step-1);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  /* Phone numbers never break mid-number. */
  .contact__links a[href^='https://wa.me/'] .contact__value {
    white-space: nowrap;
    overflow-wrap: normal;
  }

  .contact__links a:focus-visible {
    outline: 2px solid var(--c-blue);
    outline-offset: 4px;
  }

  .contact__arrow {
    font-size: 1.3rem;
    transition: transform var(--t-med) var(--ease-out), color var(--t-fast);
  }

  .contact__links a:hover,
  .contact__links a:focus-visible {
    padding-left: 12px;
  }

  .contact__links a:hover .contact__arrow,
  .contact__links a:focus-visible .contact__arrow {
    color: var(--c-blue);
    transform: translate(4px, -4px);
  }

  .contact__unavailable {
    color: rgb(242 240 234 / 0.82);
  }


  @media (max-width: 900px) {
    .contact__intro,
    .contact__links {
      grid-column: 1 / -1;
    }
    .contact__links a {
      grid-template-columns: 1fr auto;
      row-gap: 6px;
      min-height: 76px;
    }
    .contact__links .label {
      grid-column: 1 / -1;
    }
  }
</style>
