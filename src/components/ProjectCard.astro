---
import Media from './Media.astro';
import { dimensionLabels, type Project } from '../content';
import { resolveImage } from '../lib/media';
import { getImage } from 'astro:assets';

interface Props {
  project: Project;
  index: number;
  layout: string;
}

const { project, index, layout } = Astro.props;
const sizesByLayout: Record<string, string> = {
  wide: '(max-width: 720px) 100vw, 92vw',
  left: '(max-width: 720px) 100vw, 56vw',
  right: '(max-width: 720px) 100vw, 40vw',
  narrow: '(max-width: 720px) 100vw, 40vw',
  offset: '(max-width: 720px) 100vw, 48vw',
};

// Poster for hover previews: an optimised still so the video never needs to download first.
const posterSrc = project.preview ? resolveImage(project.preview.poster ?? project.cover.src) : undefined;
const poster = posterSrc ? (await getImage({ src: posterSrc, width: 1280, format: 'webp' })).src : undefined;
---

<li class="card" data-layout={layout} data-category={project.category} data-card>
  <a class="card__link" href={`/work/${project.slug}/`}>
    <div class="card__media" data-card-media>
      <Media
        src={project.cover.src}
        alt={project.cover.alt}
        focal={project.cover.focal}
        sizes={sizesByLayout[layout]}
        widths={[480, 768, 1080, 1440, 1920]}
        transitionName={`cover-${project.slug}`}
      />
      {
        project.preview && (
          <video
            class="card__video"
            muted
            loop
            playsinline
            preload="none"
            poster={poster}
            aria-hidden="true"
            tabindex="-1"
            data-preview
            data-src={project.preview.src}
            data-type={project.preview.type ?? 'video/mp4'}
          />
        )
      }
      <span class="card__cat label">{dimensionLabels[project.category]}</span>
      {project.sample && <span class="card__sample label">Sample · dev only</span>}
    </div>
    <div class="card__body">
      <span class="card__index label" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <h3 class="card__title display">{project.title}</h3>
      <p class="card__meta label">
        {project.role}{project.year ? ` · ${project.year}` : ''}
      </p>
      <p class="card__summary">{project.summary}</p>
    </div>
  </a>
  {
    project.preview && (
      <button class="card__play label" type="button" data-preview-toggle aria-pressed="false">
        <span aria-hidden="true">▶</span> Play preview<span class="sr-only">: {project.title}</span>
      </button>
    )
  }
</li>

<style>
  .card {
    position: relative;
    grid-column: span 12;
  }

  .card[hidden] {
    display: none;
  }

  .card.is-filtered-in {
    animation: card-in 0.8s var(--ease-out) both;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .card[data-layout='wide'] { grid-column: 1 / -1; }
  .card[data-layout='left'] { grid-column: 1 / span 7; }
  .card[data-layout='right'] { grid-column: 9 / span 4; margin-top: clamp(64px, 12vw, 200px); }
  .card[data-layout='narrow'] { grid-column: 2 / span 5; }
  .card[data-layout='offset'] { grid-column: 7 / span 6; margin-top: clamp(48px, 8vw, 140px); }

  .card[data-layout='wide'] .card__media { aspect-ratio: 2.2 / 1; }
  .card[data-layout='left'] .card__media { aspect-ratio: 4 / 3; }
  .card[data-layout='right'] .card__media { aspect-ratio: 4 / 5; }
  .card[data-layout='narrow'] .card__media { aspect-ratio: 1 / 1; }
  .card[data-layout='offset'] .card__media { aspect-ratio: 16 / 10; }

  .card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card__link:focus-visible {
    outline-offset: 8px;
  }

  .card__media {
    position: relative;
    overflow: hidden;
    background: var(--c-charcoal);
  }

  .card__media :global(img),
  .card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 1.1s var(--ease-out),
      filter 0.6s var(--ease-out),
      opacity 0.5s var(--ease-out);
  }

  .card__media :global(img) {
    filter: grayscale(0.85) contrast(1.05);
  }

  .card__video {
    opacity: 0;
  }

  .card.is-playing .card__video {
    opacity: 1;
  }

  .card__link:focus-visible .card__media :global(img) {
    filter: grayscale(0);
  }

  @media (hover: hover) {
    .card__link:hover .card__media :global(img) {
      filter: grayscale(0);
      transform: scale(1.035);
    }
    .card__link:hover .card__title {
      color: var(--c-blue);
    }
  }

  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px var(--c-line);
    background: linear-gradient(to top, rgb(10 10 11 / 0.45), transparent 35%);
    pointer-events: none;
  }

  .card__cat,
  .card__sample {
    position: absolute;
    z-index: 1;
    top: 16px;
    padding: 6px 10px;
    background: rgb(10 10 11 / 0.72);
    color: var(--c-ivory);
  }
  .card__cat { left: 16px; }
  .card__sample { right: 16px; color: #ffd36b; }

  .card__body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 18px;
    padding-top: 20px;
  }

  .card__index {
    grid-row: span 3;
    padding-top: 0.5em;
    color: var(--c-blue);
  }

  .card__title {
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.5rem);
    line-height: 1.08;
    transition: color var(--t-fast);
  }

  .card[data-layout='wide'] .card__title {
    font-size: clamp(2.4rem, 1rem + 5vw, 6rem);
  }

  .card__summary {
    color: var(--c-gray);
    max-width: 52ch;
  }

  .card__play {
    position: absolute;
    z-index: 2;
    right: 12px;
    top: 12px;
    display: none;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    background: rgb(10 10 11 / 0.8);
    color: var(--c-ivory);
    cursor: pointer;
  }

  /* Touch / coarse pointers: explicit playback instead of hover */
  @media (hover: none), (pointer: coarse) {
    .card__play {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .card__sample {
      top: auto;
      bottom: 16px;
    }
  }

  @media (max-width: 900px) {
    .card[data-layout] {
      grid-column: 1 / -1;
      margin-top: 0;
    }
    .card[data-layout] .card__media {
      aspect-ratio: 4 / 3;
    }
    .card[data-layout='wide'] .card__media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
