---
import ProjectCard from './ProjectCard.astro';
import { dimensionLabels, publishedProjects, work } from '../content';

const LAYOUTS = ['wide', 'left', 'right', 'narrow', 'offset'];
const filters = [{ id: 'all', label: 'All' }, ...Object.entries(dimensionLabels).map(([id, label]) => ({ id, label }))];
const counts: Record<string, number> = { all: publishedProjects.length };
for (const p of publishedProjects) counts[p.category] = (counts[p.category] ?? 0) + 1;
---

<section class:list={['work', publishedProjects.length === 0 && 'work--empty']} id="work" aria-labelledby="work-title" data-work>
  <div class="wrap">
    <div class="work__head" data-reveal>
      <h2 id="work-title" class="work__title display">{work.headline}</h2>
      {publishedProjects.length > 0 ? (
        <p class="work__intro">{work.intro}</p>
      ) : (
        <div class="work__empty">
          <p class="work__empty-title">{work.emptyTitle}</p>
          <p class="work__empty-text">{work.emptyText}</p>
        </div>
      )}
    </div>

    {
      publishedProjects.length > 0 && (
        <>
          <div class="work__filters" role="group" aria-label="Filter projects by dimension" data-filters>
            {filters.map((f, i) => (
              <button
                type="button"
                class="work__filter"
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-filter={f.id}
                disabled={!counts[f.id]}
              >
                {f.label}
                <sup aria-hidden="true">{counts[f.id] ?? 0}</sup>
                <span class="sr-only">({counts[f.id] ?? 0} projects)</span>
              </button>
            ))}
          </div>
          <p class="sr-only" aria-live="polite" data-filter-status />
          <ol class="work__grid" data-work-grid>
            {publishedProjects.map((project, i) => (
              <ProjectCard project={project} index={i} layout={LAYOUTS[i % LAYOUTS.length]} />
            ))}
          </ol>
        </>
      )
    }
  </div>
</section>

<style>
  .work {
    padding-block: clamp(72px, 9vw, 128px);
  }

  .work--empty {
    padding-block: clamp(56px, 7vw, 96px);
    border-bottom: 1px solid var(--c-line);
  }

  .work__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 16px var(--gutter);
    align-items: end;
    padding-bottom: clamp(24px, 3vw, 40px);
    margin-bottom: clamp(28px, 4vw, 56px);
    border-bottom: 1px solid var(--c-line);
  }

  .work--empty .work__head {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: 0;
  }

  .work__title {
    font-size: var(--h-sub);
    line-height: 1.06;
  }

  .work__intro,
  .work__empty-text {
    color: var(--c-gray);
    max-width: 40ch;
  }

  .work__empty {
    display: grid;
    gap: 8px;
  }

  .work__empty-title {
    font-size: var(--body-l);
    font-weight: 500;
    line-height: 1.4;
    color: rgb(242 240 234 / 0.88);
  }

  .work__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: clamp(32px, 5vw, 64px);
  }

  .work__filter {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    font-family: var(--f-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background-color var(--t-fast),
      color var(--t-fast),
      border-color var(--t-fast);
  }

  .work__filter sup {
    font-size: 0.62rem;
    color: var(--c-gray);
    transform: translateY(-0.4em);
  }

  .work__filter:hover:not(:disabled) {
    border-color: var(--c-ivory);
  }

  .work__filter[aria-pressed='true'] {
    background: var(--c-ivory);
    color: var(--c-black);
    border-color: var(--c-ivory);
  }

  .work__filter[aria-pressed='true'] sup {
    color: var(--c-blue);
  }

  .work__filter:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(56px, 7vw, 112px) var(--gutter);
  }

  @media (max-width: 900px) {
    .work__head {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
