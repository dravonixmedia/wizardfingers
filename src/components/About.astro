---
import BackgroundMedia from './BackgroundMedia.astro';
import { about, backgrounds } from '../content';

const media = backgrounds.sections.about;
---

<section class:list={['about', !media && 'about--no-media']} id="about" aria-labelledby="about-title">
  <BackgroundMedia media={media} variant="about" />
  <div class="about__scrim" aria-hidden="true"></div>
  <div class="wrap about__inner">
    <div class="about__copy" data-reveal>
      <p class="label label--accent">{about.label}</p>
      <h2 id="about-title" class="about__title display">{about.headline}</h2>
      <p class="about__body">{about.body}</p>
      <p class="about__affiliation">
        {about.affiliation.prefix}{' '}
        <a href={about.affiliation.url} target="_blank" rel="noopener noreferrer">
          {about.affiliation.company}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </p>
    </div>
    {
      media?.type === 'video' && (
        <button class="bg-toggle" type="button" data-bg-toggle hidden>
          <span data-bg-toggle-label>Pause</span>
          <span class="sr-only"> background video</span>
        </button>
      )
    }
  </div>
</section>

<style>
  .about {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: min(84svh, 820px);
    overflow: hidden;
  }

  .about--no-media {
    min-height: 0;
  }

  .about > :global(.bg) {
    z-index: -2;
  }

  .about__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(10 10 11 / 0.88) 0%, rgb(10 10 11 / 0.5) 45%, transparent 75%);
  }

  .about__inner {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: clamp(80px, 10vw, 144px);
  }

  .about__copy {
    display: grid;
    gap: 18px;
    max-width: 34rem;
  }

  .about__title {
    font-size: var(--h-sub);
    line-height: 1.06;
  }

  /* Understated: smaller and quieter than the biography; only the company name is a link. */
  .about__affiliation {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgb(242 240 234 / 0.62);
  }

  .about__affiliation a {
    color: rgb(242 240 234 / 0.88);
    text-decoration: underline;
    text-decoration-color: rgb(242 240 234 / 0.35);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color var(--t-fast), color var(--t-fast);
  }

  .about__affiliation a:hover {
    color: var(--c-ivory);
    text-decoration-color: currentColor;
  }

  .about__affiliation a:focus-visible {
    outline: 2px solid var(--c-blue);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .about__body {
    max-width: 44ch;
    font-size: var(--body-l);
    line-height: 1.6;
    color: rgb(242 240 234 / 0.88);
  }


  /* Portrait background: the biography stays on the left and the scrim fades out before
     Pranav's face (right half), so the image's own low-key lighting is preserved. */
  .about:not(.about--no-media) .about__scrim {
    background: linear-gradient(90deg, rgb(10 10 11 / 0.85) 0%, rgb(10 10 11 / 0.6) 30%, rgb(10 10 11 / 0.2) 46%, transparent 54%);
  }

  /* Narrower than the image's dark half, so the portrait keeps its breathing room. */
  .about:not(.about--no-media) .about__copy {
    max-width: min(34rem, 42%);
  }

  /* Links and /#about land with the section at the very top (the fixed header overlays the
     portrait, as approved) rather than clearing the header and showing a strip of Work. */
  .about:not(.about--no-media) {
    scroll-margin-top: calc(-1 * (var(--header-h) + 16px));
  }

  /* Wide screens: a full-height section with the portrait starting below the fixed header,
     framed exactly as approved. No scroll parallax, which would zoom into the portrait. */
  @media (min-width: 1024px) {
    .about:not(.about--no-media) {
      min-height: 100vh;
      min-height: 100lvh;
    }
    .about:not(.about--no-media) > :global(.bg) {
      top: var(--header-h);
    }
  }

  /* Narrower screens: no room beside the face, so the portrait sits above the text at its
     natural proportions and fades into the page. */
  @media (max-width: 1023px) {
    .about:not(.about--no-media) {
      flex-direction: column;
      min-height: 0;
    }
    .about:not(.about--no-media) > :global(.bg) {
      position: relative;
      inset: auto;
      flex: none;
      aspect-ratio: 1672 / 941;
      /* The scroll parallax (≥ 900px) would shift the stacked portrait over the text. */
      transform: none !important;
    }
    .about:not(.about--no-media) > :global(.bg)::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 30%;
      background: linear-gradient(to top, var(--c-black), transparent);
    }
    .about:not(.about--no-media) .about__scrim {
      display: none;
    }
    .about:not(.about--no-media) .about__inner {
      margin-top: -40px;
      padding-top: 0;
    }
    .about:not(.about--no-media) .about__copy {
      max-width: 34rem;
    }
  }

  @media (max-width: 720px) {
    /* Phones use the portrait crop (backgrounds.ts → mobileSrc). */
    .about:not(.about--no-media) > :global(.bg) {
      aspect-ratio: 820 / 941;
      max-height: 72svh;
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .about__scrim {
      background: linear-gradient(0deg, rgb(10 10 11 / 0.9) 0%, rgb(10 10 11 / 0.5) 55%, rgb(10 10 11 / 0.2));
    }
    .about__inner {
      align-items: flex-end;
    }
  }
</style>
