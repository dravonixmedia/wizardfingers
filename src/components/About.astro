---
import BackgroundMedia from './BackgroundMedia.astro';
import { about, backgrounds } from '../content';

const media = backgrounds.sections.about;
const [first, ...rest] = about.headline.split(' the ');
const emphasis = rest.length ? `the ${rest.join(' the ')}` : '';
---

<section class:list={['about', !media && 'about--no-media']} id="about" aria-labelledby="about-title">
  <BackgroundMedia media={media} variant="about" parallax />
  <div class="about__scrim" aria-hidden="true"></div>
  <div class="wrap about__inner">
    <div class="about__copy" data-reveal>
      <p class="label label--accent">{about.label}</p>
      <h2 id="about-title" class="about__title">
        <span class="display">{first}</span>
        {emphasis && <span class="serif">{emphasis}</span>}
      </h2>
      <p class="about__body">{about.body}</p>
    </div>
    {
      media?.type === 'video' && (
        <button class="bg-toggle" type="button" data-bg-toggle hidden>
          <span data-bg-toggle-label>Pause</span>
          <span class="sr-only"> background video</span>
        </button>
      )
    }
  </div>
</section>

<style>
  .about {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: min(84svh, 820px);
    overflow: hidden;
  }

  .about--no-media {
    min-height: 0;
  }

  .about > :global(.bg) {
    z-index: -2;
  }

  .about__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(10 10 11 / 0.88) 0%, rgb(10 10 11 / 0.5) 45%, transparent 75%);
  }

  .about__inner {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: clamp(80px, 10vw, 144px);
  }

  .about__copy {
    display: grid;
    gap: 20px;
    max-width: 46rem;
  }

  .about__title {
    font-weight: 400;
    font-size: clamp(2.9rem, 1.4rem + 5vw, 6.75rem);
    line-height: 0.92;
  }

  .about__title .display {
    display: block;
  }

  .about__title .serif {
    display: block;
    font-size: 1.06em;
    color: rgb(242 240 234 / 0.82);
  }

  .about__body {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: rgb(242 240 234 / 0.88);
  }


  /* Portrait background: the biography stays on the left and the scrim fades out before
     Pranav's face (right half), so the image's own low-key lighting is preserved. */
  .about:not(.about--no-media) .about__scrim {
    background: linear-gradient(90deg, rgb(10 10 11 / 0.85) 0%, rgb(10 10 11 / 0.6) 30%, rgb(10 10 11 / 0.2) 46%, transparent 54%);
  }

  .about:not(.about--no-media) .about__copy {
    max-width: min(46rem, 50%);
  }

  /* Narrower screens: no room beside the face, so the portrait sits above the text at its
     natural proportions and fades into the page. */
  @media (max-width: 1023px) {
    .about:not(.about--no-media) {
      flex-direction: column;
      min-height: 0;
    }
    .about:not(.about--no-media) > :global(.bg) {
      position: relative;
      inset: auto;
      flex: none;
      aspect-ratio: 1672 / 941;
      /* The scroll parallax (≥ 900px) would shift the stacked portrait over the text. */
      transform: none !important;
    }
    .about:not(.about--no-media) > :global(.bg)::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 30%;
      background: linear-gradient(to top, var(--c-black), transparent);
    }
    .about:not(.about--no-media) .about__scrim {
      display: none;
    }
    .about:not(.about--no-media) .about__inner {
      margin-top: -40px;
      padding-top: 0;
    }
    .about:not(.about--no-media) .about__copy {
      max-width: 46rem;
    }
  }

  @media (max-width: 720px) {
    /* Phones use the portrait crop (backgrounds.ts → mobileSrc). */
    .about:not(.about--no-media) > :global(.bg) {
      aspect-ratio: 820 / 941;
      max-height: 72svh;
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .about__scrim {
      background: linear-gradient(0deg, rgb(10 10 11 / 0.9) 0%, rgb(10 10 11 / 0.5) 55%, rgb(10 10 11 / 0.2));
    }
    .about__inner {
      align-items: flex-end;
    }
  }
</style>
