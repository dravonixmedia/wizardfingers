---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { BackgroundMedia } from '../content/types';
import { resolveImage } from '../lib/media';

/**
 * Full-bleed background: art-directed image, or muted looping video over a
 * poster. Without configured media it renders a neutral charcoal "studio"
 * backdrop (variant controls the light direction) — never a broken frame.
 */
interface Props {
  media?: BackgroundMedia;
  /** Placeholder lighting preset used when no media is configured. */
  variant?: 'motion' | 'intelligence' | 'digital' | 'about' | 'contact';
  /** Only for the first visible background on the page. */
  priority?: boolean;
  /** Gentle scroll parallax (desktop, motion allowed). */
  parallax?: boolean;
  class?: string;
}

const { media, variant = 'motion', priority = false, parallax = false, class: className } = Astro.props;

const WIDTHS = [640, 960, 1280, 1920, 2560];
async function sources(meta: ImageMetadata, widths = WIDTHS) {
  const ws = widths.filter((w) => w <= meta.width);
  if (!ws.length || ws[ws.length - 1] < meta.width) ws.push(Math.min(meta.width, 2560));
  const [avif, webp, jpg] = await Promise.all([
    getImage({ src: meta, widths: ws, format: 'avif', quality: 70 }),
    getImage({ src: meta, widths: ws, format: 'webp', quality: 78 }),
    getImage({ src: meta, width: Math.min(meta.width, 1920), format: 'jpg', quality: 80 }),
  ]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, fallback: jpg.src, width: meta.width, height: meta.height };
}

const mainSrc = media ? (media.type === 'image' ? media.src : media.poster) : undefined;
const mobileImgSrc = media ? (media.type === 'image' ? media.mobileSrc : media.mobilePoster) : undefined;
const mainMeta = resolveImage(mainSrc);
const mobileMeta = resolveImage(mobileImgSrc);
const main = mainMeta ? await sources(mainMeta) : undefined;
const mobile = mobileMeta ? await sources(mobileMeta, [480, 720, 1080, 1440]) : undefined;

const position = media?.position ?? '50% 50%';
const style = [
  `--bg-pos:${position}`,
  `--bg-pos-m:${media?.mobilePosition ?? position}`,
  `--bg-overlay:${media?.overlay ?? 0.45}`,
].join(';');
const alt = media?.type === 'image' ? (media.alt ?? '') : '';
const isVideo = media?.type === 'video' && Boolean(main);
---

<div class:list={['bg', !main && `bg--placeholder bg--${variant}`, className]} style={style} data-bg data-parallax-bg={parallax ? '' : undefined}>
  {
    main && (
      <picture class="bg__picture">
        {mobile && <source media="(max-width: 720px)" type="image/avif" srcset={mobile.avif} sizes="100vw" />}
        {mobile && <source media="(max-width: 720px)" type="image/webp" srcset={mobile.webp} sizes="100vw" />}
        <source type="image/avif" srcset={main.avif} sizes="100vw" />
        <source type="image/webp" srcset={main.webp} sizes="100vw" />
        <img
          class="bg__img"
          src={main.fallback}
          alt={alt}
          width={main.width}
          height={main.height}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </picture>
    )
  }
  {
    isVideo && media?.type === 'video' && (
      <video
        class="bg__video"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        aria-hidden="true"
        tabindex="-1"
        data-bg-video
        data-src={media.src}
        data-src-mobile={media.mobileSrc}
      />
    )
  }
  <div class="bg__overlay" aria-hidden="true"></div>
</div>

<style>
  .bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--c-black);
  }

  .bg__picture,
  .bg__img,
  .bg__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bg__img,
  .bg__video {
    object-fit: cover;
    object-position: var(--bg-pos);
  }

  /* Hidden until its first frame is presented (see scripts/backgrounds.ts). The poster is
     that exact frame, so this short fade only smooths decoder rounding. */
  .bg__video {
    opacity: 0;
    transition: opacity 0.4s linear;
  }

  .bg__video:global(.is-playing) {
    opacity: 1;
  }

  @media (max-width: 720px) {
    .bg__img,
    .bg__video {
      object-position: var(--bg-pos-m);
    }
  }

  .bg__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(10 10 11 / 0.5), transparent 20%),
      linear-gradient(to top, rgb(10 10 11 / calc(var(--bg-overlay) + 0.3)), transparent 55%),
      rgb(10 10 11 / var(--bg-overlay));
    pointer-events: none;
  }

  /* Temporary studio backdrop: charcoal sweep with one soft key light. */
  .bg--placeholder {
    --lx: 50%;
    --ly: 38%;
    --lw: 62%;
    --lh: 70%;
    --bg-overlay: 0;
    background:
      radial-gradient(var(--lw) var(--lh) at var(--lx) var(--ly), #3a3a3e 0%, #252528 38%, #161618 68%, #0c0c0d 100%);
  }

  .bg--placeholder::before {
    /* Floor falloff + vignette */
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(10 10 11 / 0.85), transparent 45%),
      radial-gradient(120% 90% at 50% 40%, transparent 55%, rgb(0 0 0 / 0.55));
  }

  .bg--placeholder::after {
    /* Restrained blue rim light */
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(var(--rw, 38%) var(--rh, 45%) at var(--rx, 88%) var(--ry, 18%), rgb(66 117 255 / 0.16), transparent 70%);
    mix-blend-mode: screen;
  }

  .bg--motion { --lx: 50%; --ly: 34%; }
  .bg--intelligence { --lx: 30%; --ly: 30%; --lw: 70%; --rx: 78%; --ry: 70%; --rw: 45%; }
  .bg--digital { --lx: 68%; --ly: 40%; --lw: 58%; --rx: 12%; --ry: 25%; }
  .bg--about { --lx: 24%; --ly: 45%; --lw: 55%; --lh: 80%; --rx: 90%; --ry: 85%; }
  .bg--contact { --lx: 50%; --ly: 100%; --lw: 80%; --lh: 60%; --rx: 50%; --ry: 110%; --rw: 60%; --rh: 50%; }
</style>
