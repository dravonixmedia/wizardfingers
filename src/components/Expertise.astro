---
import { expertise } from '../content';
---

<section class="section expertise" id="expertise" aria-labelledby="expertise-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="label label--accent">Expertise</p>
      <h2 id="expertise-title" class="display">Four disciplines, one practice</h2>
      <p>Distinct crafts that inform each other — story, image and code in the same hands.</p>
    </div>

    <ol class="xp">
      {
        expertise.map((item, i) => (
          <li class="xp__row" data-reveal>
            <span class="xp__num label">0{i + 1}</span>
            <h3 class="xp__title display">{item.title}</h3>
            <p class="xp__desc">{item.description}</p>
            <ul class="xp__tags" aria-label={`${item.title} focus areas`}>
              {item.tags.map((t) => (
                <li class="label">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .xp {
    border-top: 1px solid var(--c-line);
  }

  .xp__row {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(0, 6fr) minmax(0, 4fr);
    grid-template-areas:
      'num title desc'
      'num title tags';
    gap: 12px var(--gutter);
    align-items: start;
    padding: clamp(28px, 3.4vw, 48px) 0;
    border-bottom: 1px solid var(--c-line);
    isolation: isolate;
  }

  /* Accent sweep on hover */
  .xp__row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(66 117 255 / 0.12), transparent 70%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
  }

  .xp__row::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--c-blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
  }

  .xp__row:hover::before,
  .xp__row:hover::after {
    transform: none;
  }

  .xp__num {
    grid-area: num;
    padding-top: 0.6em;
  }

  .xp__title {
    grid-area: title;
    font-size: clamp(2.2rem, 1rem + 4.2vw, 5.5rem);
    line-height: 0.92;
    transition: transform 0.7s var(--ease-out);
  }

  .xp__row:hover .xp__title {
    transform: translateX(12px);
  }

  .xp__desc {
    grid-area: desc;
    color: var(--c-gray);
    padding-top: 0.4em;
  }

  .xp__tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .xp__tags li {
    padding: 5px 10px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    color: var(--c-ivory);
    font-size: 0.66rem;
  }

  @media (max-width: 900px) {
    .xp__row {
      grid-template-columns: 2.5rem 1fr;
      grid-template-areas:
        'num title'
        'num desc'
        'num tags';
    }
  }
</style>
